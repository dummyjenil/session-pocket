{
  "name": "session-pocket",
  "displayName": "SessionPocket",
  "version": "1.0.0",
  "description": "One browser. Multiple isolated web sessions. Save, organize, and launch your accounts with SessionPocket.",
  "author": "Jenil sheth",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/session-pocket.test.ts"
  },
  "dependencies": {
    "lucide-react": "^1.38.0",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tailwindcss": "3.4.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "postcss": "8.4.33",
    "prettier": "3.2.4",
    "typescript": "5.3.3"
  },
  "manifest": {
    "permissions": [
      "cookies",
      "storage",
      "unlimitedStorage",
      "tabs",
      "activeTab",
      "scripting"
    ],
    "host_permissions": [
      "https://*/*",
      "http://*/*"
    ],
    "incognito": "spanning"
  }
}
