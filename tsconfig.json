{
  "extends": "plasmo/templates/tsconfig.base",
  "exclude": [
    "node_modules",
    "tests"
  ],
  "include": [
    ".plasmo/index.d.ts",
    "./**/*.ts",
    "./**/*.tsx"
  ],
  "compilerOptions": {
    "moduleResolution": "bundler",
    "types": ["chrome", "node"],
    "paths": {
      "~*": [
        "./src/*"
      ]
    }
  }
}
